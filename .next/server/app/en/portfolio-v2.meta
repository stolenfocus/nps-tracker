{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[lang]/layout,_N_T_/[lang]/portfolio-v2/layout,_N_T_/[lang]/portfolio-v2/page,_N_T_/en/portfolio-v2"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$lang/portfolio-v2/__PAGE__",
    "/$d$lang/portfolio-v2",
    "/$d$lang",
    "/_index",
    "/_head"
  ]
}