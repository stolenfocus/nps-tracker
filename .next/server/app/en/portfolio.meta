{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[lang]/layout,_N_T_/[lang]/portfolio/layout,_N_T_/[lang]/portfolio/page,_N_T_/en/portfolio"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$lang/portfolio/__PAGE__",
    "/$d$lang/portfolio",
    "/$d$lang",
    "/_index",
    "/_head"
  ]
}