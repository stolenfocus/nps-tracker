{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[lang]/layout,_N_T_/[lang]/streak/layout,_N_T_/[lang]/streak/page,_N_T_/en/streak"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$lang/streak/__PAGE__",
    "/$d$lang/streak",
    "/$d$lang",
    "/_index",
    "/_head"
  ]
}