{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[lang]/layout,_N_T_/[lang]/global/layout,_N_T_/[lang]/global/page,_N_T_/ko/global"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$lang/global/__PAGE__",
    "/$d$lang/global",
    "/$d$lang",
    "/_index",
    "/_head"
  ]
}