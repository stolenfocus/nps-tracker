{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[lang]/layout,_N_T_/[lang]/feed/layout,_N_T_/[lang]/feed/page,_N_T_/ko/feed"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$lang/feed/__PAGE__",
    "/$d$lang/feed",
    "/$d$lang",
    "/_index",
    "/_head"
  ]
}